<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.intent.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- Play Store & Search Discovery Keywords / Metadata -->
        <meta-data
            android:name="com.google.android.gms.app_indexing"
            android:value="true" />
        <meta-data
            android:name="app_keywords"
            android:value="telegram channel, telegram group, ton, sell, buy, whatsapp, group, forex channel, trading channel, crypto channel, tiktok, youtube, instagram, discord" />
        <meta-data
            android:name="app_category_tags"
            android:value="telegram_marketplace,ton_ads,forex_trading_signals,whatsapp_communities,social_media_assets" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
